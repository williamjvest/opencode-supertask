{
  "configVersion": 2,
  "worker": {
    "maxConcurrency": 1,
    "pollIntervalMs": 1000,
    "heartbeatIntervalMs": 30000,
    "taskTimeoutMs": 300000,
    "shutdownGracePeriodMs": 30000
  },
